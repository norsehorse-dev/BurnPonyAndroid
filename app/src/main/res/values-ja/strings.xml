    <!-- Proxy (Tor), added in 1.4.0 -->
    <string name="settings_proxy_header">プロキシ（Tor）</string>
    <string name="settings_proxy_subtitle">サーバーとの通信をすべて Tor または SOCKS5 プロキシ経由にします。オンの間は、プロキシに接続できるときだけノートの作成と管理を行います。</string>
