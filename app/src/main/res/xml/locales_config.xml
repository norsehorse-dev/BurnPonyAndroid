<?xml version="1.0" encoding="utf-8"?>
<!-- The nine languages BurnPony ships strings for. Referenced from
     <application android:localeConfig>. On Android 13+ this is what
     populates Settings -> System -> Languages -> App languages -> BurnPony,
     so the system picker and the in-app picker offer the same list. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="de" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="it" />
    <locale android:name="ja" />
    <locale android:name="pt-BR" />
    <locale android:name="ru" />
    <locale android:name="zh-CN" />
</locale-config>
